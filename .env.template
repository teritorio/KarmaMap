# Copy this file to .env and adjust paths if needed.
# All paths are relative to this directory by default (current path).

DATA_DIR=./data/

# OSM account for the Geofabrik internal download server
# (osm-internal.download.geofabrik.de), which hosts user-attribute and
# full-history extracts for OSM contributors only. Required when the
# karmamap --update-url (or a later diff update) points at the internal
# host: karmamap obtains the session cookie itself from these credentials
# and caches it in the Netscape jar <node-cache-parent>/.geofabrik.cookie.
OSM_GEOFABRIK_USER=
OSM_GEOFABRIK_PASSWORD=
